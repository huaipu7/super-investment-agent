# 密钥与配置
.env
.env.local
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 数据与缓存（运行时产物，体积大，不入库）
# 只放行一个文件：采集白名单。policy.py 启动即读它，缺了采集链路直接失败。
data/*
!data/external/
data/external/*
!data/external/sources.yaml

# 生成物
reports/
*.pdf
*.html
*.png
*.xlsx

# 办公软件临时锁文件
~$*

# IDE
.idea/
.vscode/
