# 复制此文件为 .env 并填入真实值
# 配置分层（优先级从低到高）：.env → .env.{ENV} → .env.local
#   - .env：基础配置（提交示例可参考本文件）
#   - .env.staging / .env.prod：按 ENV 覆盖（ENV 由 shell / start.bat 设置）
#   - .env.local：本机私有覆盖（不进版本库），优先级最高
# ENV 未设置时按 dev 处理；ENV 本身也建议在 shell 中设置。

# 运行环境（dev / staging / prod）
# ENV=dev

# DeepSeek V4 Flash - Anthropic 兼容接口配置
LLM_API_KEY=your_deepseek_api_key_here
LLM_API_BASE=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=4096
# 是否启用思维链(thinking)。关闭更稳更快;开启更利于深度推理但会占用 token 预算
LLM_THINKING_ENABLED=false

# 模型网关（任务→模型分层 + 降级链 + 重试）
#   MODEL_TIERS: 任务类型到模型名的映射（intent/plan/report/summary/sentiment/tool），
#                未配置的任务自动回退 LLM_MODEL
#   MODEL_FALLBACKS: 任务级降级模型链（主模型失败后依次尝试）
#   LLM_RETRY: 每模型失败重试次数（指数退避），LLM_RETRY_BACKOFF 为退避基数秒
# 例（换用更强模型生成研报）：
#   MODEL_TIERS={"intent":"deepseek-v4-flash","report":"deepseek-v4-flash"}
#   MODEL_FALLBACKS={"report":["deepseek-v4-flash"]}
LLM_RETRY=3
LLM_RETRY_BACKOFF=0.5

# 服务端口
SERVER_PORT=8000

# 数据源开关
SOURCE_YFINANCE=true
SOURCE_AKSHARE=true
SOURCE_SINA=true
SOURCE_FUND=true

# RAG（默认可开；无任何嵌入后端时静默降级为无 RAG）
#   后端选择：配了 EMBEDDING_API_KEY → 远程嵌入；否则本地 bge-small-zh（torch 已装）。
RAG_ENABLED=true
# EMBEDDING_API_BASE=https://api.openai.com/v1   # OpenAI 兼容 /embeddings
# EMBEDDING_API_KEY=your_embedding_api_key_here
# EMBEDDING_MODEL=text-embedding-3-small

# MCP 工具桥（默认关闭；真实数据源等凭据后配置）
# MCP_ENABLED=false
# MCP_SERVERS=[{"name":"mock","transport":"stdio","command":"D:/python/python.exe","args":["scripts/run_mock_mcp_server.py","--mode","stdio"]}]
# MCP_SERVERS=[{"name":"http","transport":"http","url":"http://127.0.0.1:8090"}]

# SQLite 缓存 / 自选股 / 审计 / 合规 / 记忆
CACHE_DB_PATH=data/cache.db
WATCHLIST_DB_PATH=data/watchlist.db
AUDIT_DB_PATH=data/audit.db
COMPLIANCE_DB_PATH=data/compliance.db
MEMORY_DB_PATH=data/memory.db

# 自主深度调查（假设驱动）—— 下列数值是【硬天花板】，不是建议值。
#   两档由请求的 depth 参数选择：standard（默认）/ deep。
#   三重硬上限：轮次 / 工具调用总数 / LLM 调用总数；另有墙钟 deadline、
#   查询去重、连续无进展检测。注意 llm_calls 必须单独计：compare_peers
#   工具内部会烧 1 次 LLM 调用。
#   另注意 deadline 并非严格硬停——单次在途 LLM 请求最长可超 LLM_TIMEOUT(120s)，
#   系统会在剩余时间不足 INVESTIGATION_MIN_ROUND_SECONDS 时拒绝开启新一轮，
#   并在报告中如实写出实际超时量。
# INVESTIGATION_ENABLED=true
# INVESTIGATION_STANDARD_MAX_ROUNDS=6
# INVESTIGATION_STANDARD_MAX_TOOL_CALLS=14
# INVESTIGATION_STANDARD_MAX_LLM_CALLS=10
# INVESTIGATION_STANDARD_DEADLINE_SECONDS=300
# INVESTIGATION_STANDARD_MAX_HYPOTHESES=4
# INVESTIGATION_STANDARD_MAX_EVIDENCE_PER_HYPOTHESIS=4
# INVESTIGATION_STANDARD_MAX_PEERS=3
# INVESTIGATION_DEEP_MAX_ROUNDS=12
# INVESTIGATION_DEEP_MAX_TOOL_CALLS=32
# INVESTIGATION_DEEP_MAX_LLM_CALLS=20
# INVESTIGATION_DEEP_DEADLINE_SECONDS=720
# INVESTIGATION_DEEP_MAX_HYPOTHESES=8
# INVESTIGATION_DEEP_MAX_EVIDENCE_PER_HYPOTHESIS=6
# INVESTIGATION_DEEP_MAX_PEERS=5
# INVESTIGATION_NO_PROGRESS_WINDOW=3
# INVESTIGATION_MIN_ROUND_SECONDS=60
